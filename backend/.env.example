# ══════════════════════════════════════════════════════════════
# AI Newsroom — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ── Database (PostgreSQL / Supabase) ──────────────────────────
# Required — get these from Supabase project settings or your local Postgres.
DB_HOST=db.yourproject.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-password-here

# For local Postgres (no SSL required):
# DB_HOST=localhost
# DB_SSLMODE=disable

# SSL mode: require | prefer | disable (default: prefer)
DB_SSLMODE=prefer

# Connection pool settings
DB_POOL_MINCONN=1
DB_POOL_MAXCONN=10

# ── LLM API (for summarizer and rewriter) ─────────────────────
# Choose one provider. Both are optional — without these, the
# summarizer falls back to extractive-only and the rewriter
# produces minimal articles from the summary text.

# OpenRouter (recommended — free tier with Mistral-7B)
# Sign up at https://openrouter.ai — get a free API key.
OPENROUTER_API_KEY=sk-or-your-key-here
LLM_PROVIDER=openrouter
LLM_MODEL=mistralai/mistral-7b-instruct

# Groq (alternative — extremely fast free tier)
# Sign up at https://console.groq.com
# GROQ_API_KEY=gsk_your-key-here
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.1-8b-instant

# LLM tuning
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=2

# ── Embedding model ────────────────────────────────────────────
# Downloads ~560 MB on first run, then cached.
# Best quality for Arabic + French:
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_VECTOR_DIM=768
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_LANGUAGES=ar,fr
EMBEDDING_FETCH_BATCH=256
EMBEDDING_ENCODE_BATCH=64
EMBEDDING_DAYS_LOOKBACK=7

# DBSCAN clustering parameters
DBSCAN_EPS=0.70
DBSCAN_MIN_SAMPLES=2
CLUSTER_MIN_PAIRWISE_SIMILARITY=0.82

# ── Summarizer ─────────────────────────────────────────────────
# Use distilbart (faster, smaller) instead of bart-large-cnn
# Set to true on CPU-only machines for 6x speed improvement
SUMMARIZER_USE_DISTIL=false

# ── Rewriter ───────────────────────────────────────────────────
# Auto-publish articles that pass quality gate (score >= QUALITY_THRESHOLD)
REWRITER_AUTO_PUBLISH=false
REWRITER_DEFAULT_LANG=fr
# Embed published articles for semantic search
REWRITER_EMBED_OUTPUT=true

# Quality gate
QUALITY_THRESHOLD=0.60
QUALITY_MIN_WORDS=120
QUALITY_MAX_WORDS=2000

# ── Scraper ────────────────────────────────────────────────────
MAX_WORKERS_SOURCES=8
MAX_WORKERS_ARTICLES=10
ARTICLES_PER_SOURCE=50
MIN_CONTENT_CHARS=300
DELAY_BETWEEN_REQS=0.4

# ── API server ─────────────────────────────────────────────────
APP_ENV=development
API_SECRET_KEY=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# JWT token TTL in seconds (default 24 hours)
JWT_TTL_SECONDS=86400

# ── Media storage ──────────────────────────────────────────────
MEDIA_ROOT=./media

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
